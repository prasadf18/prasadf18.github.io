---
const { title = "Prasad Firame" } = Astro.props;
const pageTitle = title === "Home" ? "Prasad Firame" : `${title} | Prasad Firame`;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>

    <!-- favicon -->
    <link rel="icon" href="/astro.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Caveat:wght@500&display=swap" rel="stylesheet">

    <!-- apply the saved theme before paint so there is no flash -->
    <script is:inline>
      (() => {
        let t = null;
        try { t = localStorage.getItem("theme"); } catch (e) {}
        if (t !== "dark" && t !== "light") t = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        document.documentElement.dataset.theme = t;
      })();
    </script>
  </head>

  <body>
    <div class="page">
      <main class="container">
        <slot />
      </main>
    </div>
  </body>
</html>

<style is:global>
:root {
  --bg: #ffffff;
  --text: #18181b;
  --muted: #71717a;
  --line: #e4e4e7;
  --accent: #2563eb;
  --soft: #f4f4f5;
  --card: #ffffff;
  --hover: #fafafa;
  color-scheme: light;
}

:root[data-theme="dark"] {
  --bg: #0f0f11;
  --text: #e7e7ea;
  --muted: #9b9ba4;
  --line: #2b2b31;
  --accent: #7aa2ff;
  --soft: #1c1c21;
  --card: #16161a;
  --hover: #1a1a1f;
  color-scheme: dark;
}

html, body {
  transition: background-color 0.25s ease, color 0.25s ease;
}

* {
  box-sizing: border-box;
}

html, body {
  margin: 0;
  padding: 0;
  background: var(--bg);
  color: var(--text);
  font-family: "Inter", system-ui, -apple-system, "Segoe UI", sans-serif;
  line-height: 1.7;
  -webkit-font-smoothing: antialiased;
}

a,
a:link,
a:visited {
  color: var(--text);
  text-decoration: underline;
  text-decoration-color: var(--line);
  text-underline-offset: 3px;
  text-decoration-thickness: 1.5px;
  transition: color 0.15s ease, text-decoration-color 0.15s ease;
}

a:hover,
a:focus-visible {
  color: var(--accent);
  text-decoration-color: var(--accent);
}

.container {
  max-width: 640px;
  margin: 0 auto;
  padding: 4rem 1.5rem 5rem;
}

h1 {
  font-size: 1.6rem;
  line-height: 1.25;
  margin: 0 0 1rem;
  letter-spacing: -0.02em;
}

h2 {
  font-size: 1.15rem;
  margin: 2rem 0 0.5rem;
  letter-spacing: -0.01em;
}

p {
  font-size: 1rem;
  margin: 0 0 1rem;
  color: var(--text);
}

img {
  max-width: 100%;
}

code {
  background: var(--soft);
  padding: 0.1em 0.35em;
  border-radius: 4px;
  font-size: 0.9em;
}

pre {
  background: var(--soft);
  padding: 1rem;
  border-radius: 8px;
  overflow-x: auto;
  font-size: 0.88rem;
  line-height: 1.55;
}

pre code {
  background: none;
  padding: 0;
}

table {
  border-collapse: collapse;
  width: 100%;
  font-size: 0.92rem;
}

th, td {
  border-bottom: 1px solid var(--line);
  padding: 0.4rem 0.5rem;
  text-align: left;
}

blockquote {
  margin: 1rem 0;
  padding-left: 1rem;
  border-left: 3px solid var(--line);
  color: var(--muted);
}

figure {
  margin: 1.5rem 0;
  padding: 1rem;
  border: 1px solid var(--line);
  border-radius: 10px;
  background: var(--card);
}

figcaption {
  margin-top: 0.5rem;
  font-size: 0.88rem;
  color: var(--muted);
  text-align: center;
}

.featured {
  margin: 1.5rem 0 2rem;
  padding: 1rem 1.25rem;
  border: 1px solid var(--line);
  border-radius: 10px;
}

.featured h2 {
  margin-top: 0.25rem;
}

.post-date {
  color: var(--muted);
  font-size: 0.9rem;
}

.end-meta {
  margin-top: 4rem;
  display: flex;
  justify-content: space-between;
  font-size: 0.85rem;
  color: var(--muted);
}
</style>
