---
import Layout from "../layouts/Layout.astro";

const pocs = [
  {
    name: "FrameIQ",
    url: "https://github.com/prasadf18/FrameIQ",
    text: "OpenCV-powered multimodal RAG system for computer vision, scene understanding, OCR, tracking and visual search across images and video streams.",
  },
  {
    name: "Helios",
    url: "https://github.com/prasadf18/Helios",
    text: "A distributed database written in Go, inspired by Google's Bigtable.",
  },
  {
    name: "ozone",
    url: "https://github.com/prasadf18/ozone",
    text: "An in-memory key-value database with durable write-ahead logging via Kafka, able to rebuild state after crashes.",
  },
  {
    name: "gocage",
    url: "https://github.com/prasadf18/gocage",
    text: "A lightweight container runtime written in Go, inspired by Docker.",
  },
  {
    name: "proxygo",
    url: "https://github.com/prasadf18/proxygo",
    text: "A lightweight reverse proxy built in Go.",
  },
  {
    name: "Orbit",
    url: "https://github.com/prasadf18/Orbit",
    text: "A secure ephemeral cloud compute engine that spins up isolated execution environments on demand using Docker.",
  },
];
---

<Layout title="Research">
  <h1>research</h1>

  <p class="intro">
    I write up things I dig into to understand how systems work one level down. The notes live in a GitHub repo, and the proofs of concept I build along the way are listed below.
  </p>

  <section>
    <h2>research</h2>
    <div class="card">
      <p class="post-date">2026-11-20</p>
      <h3><a href="https://github.com/prasadf18/research/tree/main/postgres-listen-notify">The one lock hiding behind Postgres LISTEN/NOTIFY</a></h3>
      <p>
        Two well-known write-ups disagree on whether LISTEN/NOTIFY scales. I read both, plus the docs, to find out why one global lock sits in the commit path, what batching does about it, and what is still unclear.
      </p>
      <p>
        <a href="https://github.com/prasadf18/research">research repo</a>
        ·
        <a href="/blog/postgres-notify-global-lock/">read it here</a>
      </p>
    </div>
  </section>

  <section>
    <h2>proofs of concept</h2>
    <div class="cards">
      {pocs.map((p) => (
        <div class="card">
          <h3><a href={p.url} target="_blank" rel="noopener">{p.name}</a></h3>
          <p>{p.text}</p>
        </div>
      ))}
    </div>
  </section>
</Layout>

<style>
.intro {
  color: var(--muted);
  margin-bottom: 2rem;
}

section {
  margin-bottom: 2.25rem;
}

section h2 {
  font-size: 0.8rem;
  font-weight: 600;
  letter-spacing: 0.06em;
  color: var(--muted);
  margin: 0 0 0.6rem;
}

.cards {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}

.card {
  padding: 1rem 1.25rem;
  border: 1px solid var(--line);
  border-radius: 10px;
}

.card h3 {
  font-size: 1.05rem;
  margin: 0.15rem 0 0.4rem;
}

.card p {
  margin: 0 0 0.5rem;
}

.card p:last-child {
  margin-bottom: 0;
}
</style>
