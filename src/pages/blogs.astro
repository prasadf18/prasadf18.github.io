---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";

const posts = await getCollection("blog");

// latest first
posts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const personal = posts.filter((p) => p.data.category === "personal");

const sections = [
  {
    title: "personal blog",
    note: "life, careers, money, trips, movies and anything else I feel like writing about",
    items: personal,
  },
];
---

<Layout title="Blogs">
  <h1>blogs</h1>

  {sections.map((s) => (
    <section>
      <h2>{s.title}</h2>
      <p class="note">{s.note}</p>
      <ul>
        {s.items.map((post) => (
          <li>
            <span class="post-date">{post.data.date.toISOString().slice(0, 10)}</span>
            <a href={`/blog/${post.id.replace(".md", "")}/`}>{post.data.title}</a>
          </li>
        ))}
      </ul>
    </section>
  ))}

  <p><a href="/technical">technical notes</a></p>
</Layout>

<style>
section {
  margin-bottom: 2.25rem;
}

section h2 {
  font-size: 0.8rem;
  font-weight: 600;
  letter-spacing: 0.06em;
  color: var(--muted);
  margin: 0 0 0.2rem;
}

.note {
  color: var(--muted);
  font-size: 0.92rem;
  margin-bottom: 0.8rem;
}

ul {
  list-style: none;
  margin: 0;
  padding: 0;
}

li {
  display: flex;
  gap: 0.9rem;
  margin-bottom: 0.45rem;
}

.post-date {
  flex: 0 0 5.8rem;
}

@media (max-width: 480px) {
  li {
    flex-direction: column;
    gap: 0;
  }
}
</style>
