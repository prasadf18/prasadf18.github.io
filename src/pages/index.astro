---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";

const posts = await getCollection("blog");
posts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
// Home shows personal posts only. Technical notes live on /technical.
const latestPosts = posts.filter((p) => p.data.category === "personal").slice(0, 5);

// Used for the "been here since" counter.
const born = "2003-03-18T00:00:00Z";
const YEAR_MS = 365.2425 * 24 * 60 * 60 * 1000;
const initialAge = ((Date.now() - new Date(born).getTime()) / YEAR_MS).toFixed(9);

// Edit this list to change the timeline. Newest first.
const years = [
  {
    year: "2027",
    text: "Go deep on databases and distributed systems, launch more apps, give my first talk and contribute to open source.",
  },
  {
    year: "2026",
    text: "Started ACE Labs alongside my day job, started this blog and built <a href=\"/space/\">Known Worlds</a>.",
  },
  {
    year: "2025",
    text: "Moved into AI engineering: picked up Python and built a voice agent and a few agents with Claude Code.",
  },
  {
    year: "2024",
    text: "Cold outreach got me my first internship, which turned into a full-time full-stack role and an award at work.",
  },
  {
    year: "2023",
    text: "Lived in Discord servers and buildspace, wanting to build but not able to yet. It changed my direction.",
  },
];
---

<Layout title="Home">
  <button id="theme-toggle" class="theme-toggle" type="button" aria-label="Switch to dark theme" title="Switch theme">
    <svg class="icon-moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
    <svg class="icon-sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4.2"/><path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M5.3 18.7l1.6-1.6M17.1 6.9l1.6-1.6"/></svg>
  </button>
  <header class="hero">
    <h1>hi, I'm Prasad.</h1>
    <p class="big">I build cool stuff.</p>
    <p class="since">
      been here since <span id="age" data-born={born} title="and counting">{initialAge}</span> years.
    </p>
    <p>
      I'm an engineer, mostly into backend, but still figuring out my identity in tech. I like databases, distributed systems and AI agents. I also like to travel, and I write when the mood strikes.
    </p>
    <p>
      I like it when people use my code. My goal is to create impact and help all sentient beings.
    </p>
  </header>

  <section>
    <h2>my story</h2>
    <p>
      Read my origin story <a href="/origin-story">here</a>.
    </p>
  </section>

  <section>
    <h2>right now</h2>
    <p>
      Going from breadth to depth in databases, distributed systems and AI agents, and building small apps on my own time through <a href="https://acelabs-hq.github.io/acelabs/">ACE Labs</a>, independent of my day job.
    </p>
  </section>

  <section>
    <h2>the last few years</h2>
    <ol class="timeline">
      {years.map((y) => (
        <li>
          <span class="year">{y.year}</span>
          <div>
            <p set:html={y.text} />
            {y.card && (
              <a class="linkcard" href={y.card.href} target="_blank" rel="noopener">
                <span class="linkcard-title">{y.card.title}</span>
                <span class="linkcard-note">{y.card.note}</span>
              </a>
            )}
            {y.image && (
              <a class="thumb" href={y.image} target="_blank" rel="noopener" title="Open full photo">
                <img src={y.image} alt={y.imageAlt} loading="lazy" />
                <span>{y.caption}</span>
              </a>
            )}
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section>
    <h2>blog</h2>
    <ul class="posts">
      {latestPosts.map((post) => (
        <li>
          <span class="post-date">{post.data.date.toISOString().slice(0, 10)}</span>
          <a href={`/blog/${post.id.replace(".md", "")}/`}>{post.data.title}</a>
        </li>
      ))}
    </ul>
    <p><a href="/blogs">all posts</a> · <a href="/technical">technical notes</a></p>
  </section>

  <section>
    <h2>collection</h2>
    <p>
      The <a href="/collection">anime, manga and other things</a> I keep around.
    </p>
  </section>

  <section>
    <h2>say hi</h2>
    <p>
      <a href="https://x.com/rev_proxy">twitter</a>
      ·
      <a href="mailto:pfirame18@gmail.com">email</a>
    </p>
  </section>
</Layout>

<script>
  const toggle = document.getElementById("theme-toggle");
  const label = () => {
    const dark = document.documentElement.dataset.theme === "dark";
    toggle?.setAttribute("aria-label", dark ? "Switch to light theme" : "Switch to dark theme");
  };
  label();
  toggle?.addEventListener("click", () => {
    const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
    document.documentElement.dataset.theme = next;
    try { localStorage.setItem("theme", next); } catch (e) {}
    label();
  });

  const el = document.getElementById("age");
  if (el?.dataset.born) {
    const born = new Date(el.dataset.born).getTime();
    const YEAR_MS = 365.2425 * 24 * 60 * 60 * 1000;
    const tick = () => {
      el.textContent = ((Date.now() - born) / YEAR_MS).toFixed(9);
    };
    tick();
    setInterval(tick, 50);
  }
</script>

<style>
.theme-toggle {
  position: fixed;
  top: 1.1rem;
  right: 1.1rem;
  z-index: 10;
  display: grid;
  place-items: center;
  width: 2.4rem;
  height: 2.4rem;
  padding: 0;
  border: 1px solid var(--line);
  border-radius: 50%;
  background: var(--bg);
  color: var(--text);
  cursor: pointer;
  transition: background 0.15s ease, border-color 0.15s ease, transform 0.2s ease;
}

.theme-toggle:hover {
  background: var(--hover);
  transform: rotate(-12deg);
}

.theme-toggle:focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: 2px;
}

.theme-toggle .icon-sun,
:global([data-theme="dark"]) .theme-toggle .icon-moon {
  display: none;
}

:global([data-theme="dark"]) .theme-toggle .icon-sun {
  display: block;
}

.since {
  color: var(--muted);
  font-size: 0.95rem;
  margin-bottom: 1rem;
}

#age {
  font-variant-numeric: tabular-nums;
  color: var(--text);
}

.hero {
  margin-bottom: 2.5rem;
}

.hero h1 {
  font-size: 2.2rem;
  margin-bottom: 0.25rem;
}

.big {
  font-size: 1.4rem;
  font-weight: 500;
  margin-bottom: 1rem;
}

section {
  margin-bottom: 2.25rem;
}

section h2 {
  font-size: 0.8rem;
  font-weight: 600;
  text-transform: lowercase;
  letter-spacing: 0.06em;
  color: var(--muted);
  margin: 0 0 0.6rem;
}

.timeline,
.posts {
  list-style: none;
  margin: 0;
  padding: 0;
}

.timeline li {
  display: grid;
  grid-template-columns: 4rem 1fr;
  gap: 0.5rem;
  margin-bottom: 1rem;
}

.timeline .year {
  font-weight: 600;
}

.timeline p {
  margin: 0 0 0.5rem;
}

.timeline .linkcard {
  display: flex;
  flex-direction: column;
  gap: 0.1rem;
  max-width: 24rem;
  margin: 0.25rem 0 0.5rem;
  padding: 0.55rem 0.8rem;
  border: 1px solid var(--line);
  border-left: 3px solid #0a66c2;
  border-radius: 6px;
  text-decoration: none;
  transition: background 0.15s ease;
}

.timeline .linkcard:hover {
  background: var(--hover);
}

.linkcard-title {
  font-size: 0.88rem;
  font-weight: 500;
}

.linkcard-note {
  font-size: 0.82rem;
  color: var(--muted);
}

.timeline .thumb {
  display: inline-flex;
  align-items: center;
  gap: 0.6rem;
  margin-top: 0.25rem;
  font-size: 0.85rem;
  color: var(--muted);
  text-decoration: none;
}

.timeline .thumb img {
  width: 96px;
  height: 64px;
  object-fit: cover;
  border-radius: 6px;
  border: 1px solid var(--line);
}

.posts li {
  display: flex;
  gap: 0.9rem;
  margin-bottom: 0.45rem;
}

.posts .post-date {
  flex: 0 0 5.8rem;
}

@media (max-width: 480px) {
  .timeline li {
    grid-template-columns: 1fr;
    gap: 0;
  }
  .posts li {
    flex-direction: column;
    gap: 0;
  }
}
</style>
