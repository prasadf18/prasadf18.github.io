---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";

const posts = await getCollection("blog");
posts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const latestPosts = posts.slice(0, 3);

// Used for the "been here since" counter.
const born = "2003-03-18T00:00:00Z";
const YEAR_MS = 365.2425 * 24 * 60 * 60 * 1000;
const initialAge = ((Date.now() - new Date(born).getTime()) / YEAR_MS).toFixed(9);

// Edit this list to change the timeline. Newest first.
const years = [
  {
    year: "2027",
    text: "First $1,000 online, a bunch of apps, more video, a first tech talk, and open source with <a href=\"https://traefik.io/\" target=\"_blank\" rel=\"noopener\">Traefik Labs</a>.",
  },
  {
    year: "2026",
    text: "Started ACE Labs, my side lab. Met builders, wrote up my research, shipped small things.",
  },
  {
    year: "2025",
    text: "Picked up Python, bought Claude Code, built a couple of agents, and went to <a href=\"https://mitramandal.ai/\" target=\"_blank\" rel=\"noopener\">mitramandal.ai</a> meetups in Pune.",
    card: {
      href: "https://www.linkedin.com/feed/update/urn:li:share:7380230648441143296/",
      title: "My LinkedIn post from a meetup",
      note: "I met people who really inspired me, including a KDE legend.",
    },
    image: "/images/mitramandal-meetup.jpg",
    imageAlt: "Group photo at a mitramandal.ai meetup in Pune, with Prasad circled in blue near the back",
    caption: "mitramandal.ai meetup, I'm in the blue circle",
  },
  {
    year: "2024",
    text: "First internship, then a full-time job. Learned clean code and teamwork. Collaboration was the biggest lesson.",
  },
  {
    year: "2023",
    text: "Lived in pop-up Discord servers, learned the builder world, and DMed a lot of random people.",
  },
];
---

<Layout title="Home">
  <header class="hero">
    <h1>hi, I'm Prasad.</h1>
    <p class="big">I build cool stuff.</p>
    <p class="since">
      been here since <span id="age" data-born={born} title="and counting">{initialAge}</span> years.
    </p>
    <p>
      Databases, distributed systems and AI agents. I travel and write when the mood strikes.
    </p>
  </header>

  <section>
    <h2>my story</h2>
    <p>
      I grew up in a small village, got curious about computers through movies and games, and I'm still trying to be a kinder person every day. <a href="/origin-story">The longer version</a>.
    </p>
  </section>

  <section>
    <h2>right now</h2>
    <p>
      Building small apps on my own time through <a href="https://acelabs-hq.github.io/acelabs/">ACE Labs</a>, going deep on databases, and chasing my first $1,000 online.
    </p>
  </section>

  <section>
    <h2>what I aspire to</h2>
    <p>
      Two rocket boosters flying back and landing upright, side by side. That is the kind of engineer I want to become: someone who builds what people call impossible and makes it work.
    </p>
    <div class="video">
      <iframe
        src="https://www.youtube-nocookie.com/embed/HVqWEoyiaBA"
        title="Falcon Heavy launch and booster landings, from CNN"
        loading="lazy"
        allow="accelerometer; encrypted-media; gyroscope; picture-in-picture"
        referrerpolicy="strict-origin-when-cross-origin"
        allowfullscreen
      ></iframe>
    </div>
    <p class="note">Falcon Heavy launch and booster landings, video by CNN.</p>
  </section>

  <section>
    <h2>the last few years</h2>
    <ol class="timeline">
      {years.map((y) => (
        <li>
          <span class="year">{y.year}</span>
          <div>
            <p set:html={y.text} />
            {y.card && (
              <a class="linkcard" href={y.card.href} target="_blank" rel="noopener">
                <span class="linkcard-title">{y.card.title}</span>
                <span class="linkcard-note">{y.card.note}</span>
              </a>
            )}
            {y.image && (
              <a class="thumb" href={y.image} target="_blank" rel="noopener" title="Open full photo">
                <img src={y.image} alt={y.imageAlt} loading="lazy" />
                <span>{y.caption}</span>
              </a>
            )}
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section>
    <h2>blog</h2>
    <ul class="posts">
      {latestPosts.map((post) => (
        <li>
          <span class="post-date">{post.data.date.toISOString().slice(0, 10)}</span>
          <a href={`/blog/${post.id.replace(".md", "")}/`}>{post.data.title}</a>
        </li>
      ))}
    </ul>
    <p><a href="/blogs">all posts</a></p>
  </section>

  <section>
    <h2>collection</h2>
    <p>
      <a href="/collection">anime and manga</a> ·
      <a href="/quotes">quotes</a> ·
      <a href="/bucket">bucket list</a> ·
      <a href="/research">research</a> ·
      <a href="https://myanimelist.net/profile/acef18" target="_blank" rel="noopener">my list</a>
    </p>
  </section>

  <section>
    <h2>say hi</h2>
    <p>
      <a href="https://x.com/rev_proxy">twitter</a>
      ·
      <a href="mailto:pfirame18@gmail.com">email</a>
    </p>
  </section>
</Layout>

<script>
  const el = document.getElementById("age");
  if (el?.dataset.born) {
    const born = new Date(el.dataset.born).getTime();
    const YEAR_MS = 365.2425 * 24 * 60 * 60 * 1000;
    const tick = () => {
      el.textContent = ((Date.now() - born) / YEAR_MS).toFixed(9);
    };
    tick();
    setInterval(tick, 50);
  }
</script>

<style>
.since {
  color: var(--muted);
  font-size: 0.95rem;
  margin-bottom: 1rem;
}

#age {
  font-variant-numeric: tabular-nums;
  color: var(--text);
}

.hero {
  margin-bottom: 2.5rem;
}

.hero h1 {
  font-size: 2.2rem;
  margin-bottom: 0.25rem;
}

.big {
  font-size: 1.4rem;
  font-weight: 500;
  margin-bottom: 1rem;
}

section {
  margin-bottom: 2.25rem;
}

section h2 {
  font-size: 0.8rem;
  font-weight: 600;
  text-transform: lowercase;
  letter-spacing: 0.06em;
  color: var(--muted);
  margin: 0 0 0.6rem;
}

.video {
  position: relative;
  aspect-ratio: 16 / 9;
  max-width: 36rem;
  margin: 0.75rem 0 0.4rem;
  border: 1px solid var(--line);
  border-radius: 8px;
  overflow: hidden;
}

.video iframe {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  border: 0;
}

.note {
  color: var(--muted);
  font-size: 0.85rem;
  margin: 0;
}

.timeline,
.posts {
  list-style: none;
  margin: 0;
  padding: 0;
}

.timeline li {
  display: grid;
  grid-template-columns: 4rem 1fr;
  gap: 0.5rem;
  margin-bottom: 1rem;
}

.timeline .year {
  font-weight: 600;
}

.timeline p {
  margin: 0 0 0.5rem;
}

.timeline .linkcard {
  display: flex;
  flex-direction: column;
  gap: 0.1rem;
  max-width: 24rem;
  margin: 0.25rem 0 0.5rem;
  padding: 0.55rem 0.8rem;
  border: 1px solid var(--line);
  border-left: 3px solid #0a66c2;
  border-radius: 6px;
  text-decoration: none;
  transition: background 0.15s ease;
}

.timeline .linkcard:hover {
  background: #fafafa;
}

.linkcard-title {
  font-size: 0.88rem;
  font-weight: 500;
}

.linkcard-note {
  font-size: 0.82rem;
  color: var(--muted);
}

.timeline .thumb {
  display: inline-flex;
  align-items: center;
  gap: 0.6rem;
  margin-top: 0.25rem;
  font-size: 0.85rem;
  color: var(--muted);
  text-decoration: none;
}

.timeline .thumb img {
  width: 96px;
  height: 64px;
  object-fit: cover;
  border-radius: 6px;
  border: 1px solid var(--line);
}

.posts li {
  display: flex;
  gap: 0.9rem;
  margin-bottom: 0.45rem;
}

.posts .post-date {
  flex: 0 0 5.8rem;
}

@media (max-width: 480px) {
  .timeline li {
    grid-template-columns: 1fr;
    gap: 0;
  }
  .posts li {
    flex-direction: column;
    gap: 0;
  }
}
</style>
