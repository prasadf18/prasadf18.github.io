---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Quotes">

  <div id="main-content">

    <h1>quotes</h1>

    <p class="post-date">things I keep coming back to</p>

    <div class="quote-grid">

      <div class="quote-card">
        <p>“All truly strong people are kind.”</p>
        <span>— Vagabond</span>
      </div>

      <div class="quote-card">
        <p>“The impediment to action advances action.”</p>
        <span>— Marcus Aurelius</span>
      </div>

      <div class="quote-card">
        <p>“Simplicity is the ultimate sophistication.”</p>
        <span>— Leonardo da Vinci</span>
      </div>

      <div class="quote-card">
        <p>“Waste no more time arguing about what a good man should be. Be one.”</p>
        <span>— Marcus Aurelius</span>
      </div>

      <div class="quote-card">
        <p>“We suffer more often in imagination than in reality.”</p>
        <span>— Seneca</span>
      </div>

      <div class="quote-card">
        <p>“He who has a why to live can bear almost any how.”</p>
        <span>— Friedrich Nietzsche</span>
      </div>

      <div class="quote-card">
        <p>“Do nothing which is of no use.”</p>
        <span>— Miyamoto Musashi</span>
      </div>

      <div class="quote-card">
        <p>“You can't connect the dots looking forward; you can only connect them looking backwards.”</p>
        <span>— Steve Jobs</span>
      </div>

      <div class="quote-card">
        <p>“Hard work is worthless for those that don't believe in themselves.”</p>
        <span>— Naruto</span>
      </div>

      <div class="quote-card">
        <p>“Do or do not. There is no try.”</p>
        <span>— Yoda</span>
      </div>

    </div>

  </div>

</Layout>

<style>

#main-content {
  max-width: 800px;
  margin: 0 auto;
}

.quote-grid {
  display: grid;
  gap: 1rem;
  margin-top: 1.5rem;
}

.quote-card {
  padding: 1rem;
  border-left: 2px solid #d4d4d8;
  background: #fafafa;
}

.quote-card p {
  margin: 0;
  font-style: italic;
}

.quote-card span {
  font-size: 0.8rem;
  color: #71717a;
  display: block;
  margin-top: 0.5rem;
}

</style>